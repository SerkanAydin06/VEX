{
  "version": 3,
  "status": "canonical",
  "character": {
    "master_examples": {
      "portrait": {
        "width": 1024,
        "height": 1536
      },
      "landscape": {
        "width": 1536,
        "height": 1024
      }
    },
    "runtime_frame_sizes": {
      "portrait": {
        "width": 512,
        "height": 768
      },
      "landscape": {
        "width": 768,
        "height": 512
      }
    },
    "default_sheet_grid": {
      "columns": 4,
      "rows": 6
    },
    "default_animation_rows": [
      "idle",
      "walk",
      "attack",
      "death",
      "idle_back",
      "walk_back"
    ],
    "default_sheet_sizes": {
      "portrait_4x6": {
        "width": 2048,
        "height": 4608
      },
      "landscape_4x6": {
        "width": 3072,
        "height": 3072
      }
    },
    "extra_animation_rule": "Keep canonical frame size; increase sheet row count only.",
    "noncanonical_source_ratio_rule": "Do not stretch an existing creature whose authored source ratio does not match the canonical portrait/landscape ratios; keep its fixed per-enemy frame ratio until dedicated art is re-exported."
  },
  "effects": {
    "master_example": {
      "width": 1254,
      "height": 1254
    },
    "runtime_frame_size": {
      "width": 256,
      "height": 256
    },
    "large_world_effect_exception": {
      "width": 512,
      "height": 512,
      "rule": "Use only for unusually large boss or world-space VFX whose visible 3D size justifies the extra texture cost. This exception does not apply to HUD/Canvas full-screen overlays."
    },
    "types": [
      "projectile",
      "projectile_trail",
      "impact",
      "decal",
      "explosion",
      "burst",
      "charge",
      "cast",
      "enemy_vfx"
    ],
    "example_sheet_sizes": {
      "4x1": {
        "width": 1024,
        "height": 256
      },
      "2x2": {
        "width": 512,
        "height": 512
      },
      "4x2": {
        "width": 1024,
        "height": 512
      },
      "4x4": {
        "width": 1024,
        "height": 1024
      }
    }
  },
  "screen_space_vfx": {
    "runtime_frame_size": {
      "width": 1280,
      "height": 720
    },
    "aspect_ratio": "16:9",
    "types": [
      "full_screen_overlay",
      "vision_debuff",
      "screen_hit_effect"
    ],
    "example_sheet_sizes": {
      "4x1": {
        "width": 5120,
        "height": 720
      },
      "4x2": {
        "width": 5120,
        "height": 1440
      }
    },
    "stretch_mode": "KEEP_ASPECT_COVERED",
    "transparent_background_preferred": true,
    "opaque_full_frame_allowed_when_intentional": true,
    "default_generate_mipmaps": false
  },
  "image_rules": {
    "format": "PNG",
    "background": "transparent",
    "preserve_aspect_ratio": true,
    "per_frame_alpha_crop": false,
    "clip_visible_content": false
  },
  "paths": {
    "runtime_enemy_assets": "assets/enemies/<enemy_id>/",
    "optional_master_archive": "art_source/enemies/<enemy_id>/"
  },
  "godot": {
    "runtime_scenes_must_not_reference_art_source": true,
    "enemy_filter": "Linear Mipmap",
    "enemy_billboard": "Fixed-Y",
    "recalibrate_on_sheet_resize": [
      "AtlasTexture regions",
      "AnimatedSprite3D.pixel_size",
      "frame Y offsets"
    ]
  },
  "migration": {
    "mode": "incremental",
    "bulk_blind_resize_existing_assets": false
  }
}
