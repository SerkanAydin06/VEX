[node name="TransferExperiment41" parent="Gameplay/LoreTerminals" unique_id=388259864 instance=ExtResource("17_lore")]
transform = Transform3D(-4.371139e-08, 0, 1, 0, 1, 0, -1, 0, -4.371139e-08, -11.894742, 0.9, -8.295494)
log_id = &"vex03_log_transfer_41"
log_title = "TRANSFER DENEYİ 41 // TERMAL KAYIP"
log_body = "Sıfır Kaynak çıkışı yüzde on iki arttı. Eşzamanlı uzaksal ölçümde karşı taraftaki jeotermal damar sıcaklığı 318 derece düştü. Bu üretim değil; iki sistem arasında zorlanmış enerji aktarımı. Yönetim, ölçümün rapordan çıkarılmasını emretti."
accent_color = Color(0.22, 0.78, 1, 1)

[node name="KorvathBiologyReport" parent="Gameplay/LoreTerminals" unique_id=429040327 instance=ExtResource("17_lore")]
transform = Transform3D(-1, 0, -8.742278e-08, 0, 1, 0, 8.742278e-08, 0, -1, 6, 8.7, 9.87374)
log_id = &"vex03_log_korvath"
log_title = "BİYOLOJİ RAPORU // KORVATH İŞÇİ KASTI"
log_body = "HellMagma örneğinin uzuv aşınması savaş kullanımına değil, yüksek basınçta kaya kırmaya uyuyor. Zırh sandığımız tabaka doğal ısı kalkanı. Bunlar asker değil. Açtığımız kapıdan geçen, ocağı ve yön duygusu yok edilmiş canlı işçiler."
accent_color = Color(1, 0.34, 0.08, 1)

[node name="EceTanEmergencySignal" parent="Gameplay/LoreTerminals" unique_id=1127023259 instance=ExtResource("17_lore")]
transform = Transform3D(-4.371139e-08, 0, -1, 0, 1, 0, 1, 0, -4.371139e-08, 23.68, 8.7, -6.8)
log_id = &"vex03_log_ece_signal"
log_title = "ACİL TIP SİNYALİ // DR. ECE TAN"
log_body = "Bastion-7, burası Dr. Ece Tan. Maden yüzeyindeki acil tıp istasyonunda on iki yaralıyla mahsur kaldık. Kül düğümü kapanırsa sinyalimiz netleşecek. Bizi duyuyorsanız kuzey tahliye hattını takip edin. Tekrar ediyorum: hayatta kalanlar var."
accent_color = Color(0.36, 0.92, 0.72, 1)

